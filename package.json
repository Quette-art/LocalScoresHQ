{
  "name": "LocalScore",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/extractEmbeddedMascots.mjs && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "vite",
    "build:native": "node scripts/extractEmbeddedMascots.mjs && vite build --mode native --outDir dist-native",
    "ios:sync": "npm run build:native && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "firebase": "12.12.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.14.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.3.0"
  }
}
